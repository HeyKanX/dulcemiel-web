FROM maven:3.9.11-eclipse-temurin-21

ARG K6_VERSION=2.3.0
ENV DEBIAN_FRONTEND=noninteractive \
    PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright \
    QA_SELENIUM_MANAGER=1 \
    QA_HEADLESS=1 \
    CHROME_BIN=/usr/bin/chromium

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl gnupg python3 python3-pip python3-venv \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc \
    && chmod a+r /etc/apt/keyrings/docker.asc \
    && . /etc/os-release \
    && printf 'Types: deb\nURIs: https://download.docker.com/linux/%s\nSuites: %s\nComponents: stable\nArchitectures: %s\nSigned-By: /etc/apt/keyrings/docker.asc\n' "$ID" "$VERSION_CODENAME" "$(dpkg --print-architecture)" > /etc/apt/sources.list.d/docker.sources \
    && curl -fsSL https://dl.k6.io/key.gpg | gpg --dearmor -o /etc/apt/keyrings/k6-archive-keyring.gpg \
    && chmod a+r /etc/apt/keyrings/k6-archive-keyring.gpg \
    && printf 'deb [signed-by=/etc/apt/keyrings/k6-archive-keyring.gpg] https://dl.k6.io/deb stable main\n' > /etc/apt/sources.list.d/k6.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends nodejs docker-ce-cli docker-compose-plugin "k6=${K6_VERSION}" \
    && rm -rf /var/lib/apt/lists/*

RUN npm install --global playwright@1.58.0 \
    && playwright install --with-deps chromium firefox webkit \
    && npm uninstall --global playwright \
    && chrome_binary="$(find /opt/ms-playwright -type f -path '*/chrome-linux*/chrome' -print -quit)" \
    && test -n "$chrome_binary" \
    && ln -s "$chrome_binary" /usr/bin/chromium \
    && chmod -R a+rX /opt/ms-playwright

WORKDIR /workspace
CMD ["sleep", "infinity"]
