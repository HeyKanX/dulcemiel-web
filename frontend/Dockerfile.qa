FROM node:20-alpine

WORKDIR /app
ARG QA_API_URL=http://backend:5000/api
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN sed -i "s#http://localhost:5000/api#${QA_API_URL}#" src/environments/environment.ts

EXPOSE 4200
CMD ["npm", "start", "--", "--host", "0.0.0.0", "--port", "4200", "--allowed-hosts", "frontend"]
